<%- include('../layout-top', { title: viewing && viewing.id ? 'Edit Viewing' : 'New Viewing', page: 'viewings', user }) %>
<div class="page-header">
  <h1 class="page-title"><%= viewing && viewing.id ? 'Edit viewing' : 'New viewing' %></h1>
  <a href="/viewings" class="btn btn-ghost">← Back</a>
</div>

<% if(error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="form-card">
  <form method="POST" action="/viewings/<%= viewing && viewing.id ? viewing.id + '/edit' : 'new' %>">

    <div class="form-section-title">Visitor details</div>
    <div class="form-grid">
      <div class="form-group">
        <label>First name <span class="req">*</span></label>
        <input type="text" name="firstname" value="<%= viewing ? viewing.firstname||'' : '' %>" required>
      </div>
      <div class="form-group">
        <label>Surname <span class="req">*</span></label>
        <input type="text" name="surname" value="<%= viewing ? viewing.surname||'' : '' %>" required>
      </div>
      <div class="form-group">
        <label>Cell number</label>
        <input type="tel" name="cell" value="<%= viewing ? viewing.cell||'' : '' %>">
      </div>
      <div class="form-group">
        <label>Email address</label>
        <input type="email" name="email" value="<%= viewing ? viewing.email||'' : '' %>">
      </div>
    </div>

    <div class="form-section-title">Viewing details</div>
    <div class="form-grid">
      <div class="form-group">
        <label>Date <span class="req">*</span></label>
        <input type="date" name="viewing_date" value="<%= viewing ? (viewing.viewing_date ? new Date(viewing.viewing_date).toISOString().split('T')[0] : '') : '' %>" required>
      </div>
      <div class="form-group">
        <label>Time</label>
        <input type="time" name="viewing_time" value="<%= viewing && viewing.viewing_time ? viewing.viewing_time.substring(0,5) : '' %>">
      </div>
      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="Scheduled" <%= !viewing || viewing.status==='Scheduled' ? 'selected':'' %>>Scheduled</option>
          <option value="Completed" <%= viewing && viewing.status==='Completed' ? 'selected':'' %>>Completed</option>
          <option value="Cancelled" <%= viewing && viewing.status==='Cancelled' ? 'selected':'' %>>Cancelled</option>
        </select>
      </div>
      <div class="form-group">
        <label>Outcome</label>
        <select name="outcome">
          <option value="Pending" <%= !viewing || viewing.outcome==='Pending' ? 'selected':'' %>>Pending</option>
          <option value="Interested" <%= viewing && viewing.outcome==='Interested' ? 'selected':'' %>>Interested</option>
          <option value="Booked" <%= viewing && viewing.outcome==='Booked' ? 'selected':'' %>>Booked</option>
          <option value="Not interested" <%= viewing && viewing.outcome==='Not interested' ? 'selected':'' %>>Not interested</option>
        </select>
      </div>
    </div>

    <div class="form-group" style="margin-top:1rem">
      <label>Notes</label>
      <textarea name="notes" rows="3" placeholder="Any additional notes…"><%= viewing ? viewing.notes||'' : '' %></textarea>
    </div>

    <div class="form-footer">
      <a href="/viewings" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Save viewing</button>
    </div>
  </form>
</div>
<%- include('../layout-bottom') %>
