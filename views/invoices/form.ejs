<%- include('../layout-top', { title: 'New Invoice', page: 'invoices', user }) %>
<div class="page-header">
  <h1 class="page-title">New invoice</h1>
  <a href="/invoices" class="btn btn-ghost">← Back</a>
</div>

<% if(error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="form-card">
  <form method="POST" action="/invoices/new">
    <input type="hidden" name="booking_type" value="<%= booking_type %>">
    <input type="hidden" name="booking_id" value="<%= booking ? booking.id : '' %>">

    <div class="form-section-title">Invoice type</div>
    <div class="form-grid">
      <div class="form-group">
        <label>Booking type</label>
        <select name="booking_type" onchange="this.form.booking_type.value=this.value">
          <option value="room" <%= booking_type==='room'?'selected':'' %>>Room booking</option>
          <option value="wedding" <%= booking_type==='wedding'?'selected':'' %>>Wedding booking</option>
        </select>
      </div>
      <div class="form-group">
        <label>Invoice type <span class="req">*</span></label>
        <select name="invoice_type" required>
          <option value="deposit" <%= !booking || booking.invoice_type==='deposit'?'selected':'' %>>Deposit invoice</option>
          <option value="final" <%= booking && booking.invoice_type==='final'?'selected':'' %>>Final invoice</option>
        </select>
      </div>
    </div>

    <div class="form-section-title">Guest details</div>
    <div class="form-grid">
      <div class="form-group">
        <label>First name <span class="req">*</span></label>
        <input type="text" name="firstname" value="<%= booking ? booking.firstname||'' : '' %>" required>
      </div>
      <div class="form-group">
        <label>Surname <span class="req">*</span></label>
        <input type="text" name="surname" value="<%= booking ? booking.surname||'' : '' %>" required>
      </div>
      <div class="form-group full">
        <label>Email address <span class="req">*</span></label>
        <input type="email" name="email" value="<%= booking ? booking.email||'' : '' %>" required>
      </div>
    </div>

    <div class="form-section-title">Invoice details</div>
    <div class="form-grid">
      <div class="form-group full">
        <label>Description</label>
        <input type="text" name="description"
          value="<%= booking ? (booking_type==='room' ? 'Room ' + (booking.room||'') + ' — ' + (booking.venue||'') : booking.venue||'') : '' %>"
          placeholder="e.g. Room 3 — Ommidraai, 3 nights">
      </div>
      <div class="form-group full">
        <label>Amount (R) <span class="req">*</span></label>
        <input type="number" step="0.01" name="amount" value="" placeholder="0.00" required>
        <div class="field-hint">Enter the amount for this invoice (deposit amount or full balance).</div>
      </div>
    </div>

    <div class="form-footer">
      <a href="/invoices" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Create invoice</button>
    </div>
  </form>
</div>
<%- include('../layout-bottom') %>
